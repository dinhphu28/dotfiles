#!/usr/bin/env bash
set -euo pipefail

VAULT="Work"
ITEM="FPT GitLab PAT"
FIELD="password"

proto=""
host=""
# user=""

# Read all input lines until empty
while IFS= read -r line && [[ -n "$line" ]]; do
  case "$line" in
    protocol=*) proto="${line#*=}" ;;
    host=*)     host="${line#*=}" ;;
    username=*) user="${line#*=}" ;;
  esac
done

case "$1" in
  get)
    user=$(op read "op://$VAULT/$ITEM/username")
    password=$(op read "op://$VAULT/$ITEM/$FIELD")

    [[ -n "$proto" ]] && echo "protocol=$proto"
    [[ -n "$host"  ]] && echo "host=$host"
    echo "username=$user"
    echo "password=$password"
    ;;
  store|erase)
    # No-op: 1Password is the source of truth
    exit 0
    ;;
esac
